# Copy to .env and set per box. NON-SECRET config only.
#
# ⚠️ The bearer token is NOT set here. It is a file-based secret so it never
# lands in `docker inspect` / the process environment. Create secret.token next
# to the compose file (same value on BOTH boxes):
#
#   umask 077
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48 > secret.token
#   chown 1000:1000 secret.token && chmod 0400 secret.token   # container app user
#
# The compose wires it via  secrets: dropbridge_token → /run/secrets/... and the
# app reads DROPBRIDGE_TOKEN_FILE=/run/secrets/dropbridge_token.
# (Back-compat: a plain DROPBRIDGE_TOKEN env var still works if you prefer it.)
#
# ── On box A ──
# DROPBRIDGE_NODE=boxA
# DROPBRIDGE_PEER_NAME=boxB
# DROPBRIDGE_PEER_URL=http://<boxB-tailnet-ip>:8787    # the other node (100.64.0.0/10)
#
# ── On box B ──
# DROPBRIDGE_NODE=boxB
# DROPBRIDGE_PEER_NAME=boxA
# DROPBRIDGE_PEER_URL=http://<boxA-tailnet-ip>:8787    # the other node (100.64.0.0/10)
#
# (find a box's tailnet IP with:  tailscale ip -4)
#
# Optional:
# DROPBRIDGE_PORT=8787
# DROPBRIDGE_OS=Linux                                  # console label (default ZimaOS)
# DROPBRIDGE_NTFY_URL=https://ntfy.sh/your-topic       # push on receive
# DROPBRIDGE_MAX_BYTES=0                                # per-file size cap in bytes (0 = unlimited)
#
# Public share links (funnel): set to this box's funnel origin so "share" hands
# out a publicly reachable URL. Requires a matching tailscale funnel mount:
#   tailscale funnel --bg --https=10000 --set-path /s http://127.0.0.1:8787/s
# DROPBRIDGE_FUNNEL_BASE=https://<node>.<your-tailnet>.ts.net:10000
# If unset, "share" still mints a token but the link is tailnet-only (not public).
